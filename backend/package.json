{
  "name": "mini-task-manager-backend",
  "version": "1.0.0",
  "description": "Mini Task Manager — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.3",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
